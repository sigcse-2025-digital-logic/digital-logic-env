{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FPGA Image Server",
            "type": "shell",
            "command": "node server.js ${workspaceFolder}/images",
            "options": {
                "cwd": "/opt/fpgaprog",
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "revealProblems": "onProblem",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true,
            },
        },
        {
            "label": "Rebuild Tasks",
            "type": "shell",
            "command": "${workspaceFolder}/.devcontainer/rebuildTasks",
            "options": {
                "cwd": "${workspaceFolder}/.devcontainer",
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "revealProblems": "onProblem",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true,
            },
        },
        {
            "label": "00.00 Review reademe.md",
            "type": "shell",
            "command": "code ${workspaceFolder}//readme.md",
        },
        {
            "label": "02.01 Edit statemachine.sv",
            "type": "shell",
            "command": "code ${workspaceFolder}/examples/statemachine/statemachine.sv",
        },
        {
            "label": "02.02 Simulate statemachine.sv",
            "type": "shell",
            "command": "${workspaceFolder}/.devcontainer/makehdl statemachine.rtl.json",
            "options": {
                "cwd": "${workspaceFolder}/examples/statemachine",
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "revealProblems": "onProblem",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true,
            },
            "problemMatcher": {
                "base": "$yosys",
                "owner": "statemachine: simulate",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/examples/statemachine",
                ],
            },
        },
        {
            "label": "02.03 Edit statemachine_tb.sv",
            "type": "shell",
            "command": "code ${workspaceFolder}/examples/statemachine/statemachine_tb.sv",
        },
        {
            "label": "02.04 statemachine testbench verification",
            "type": "shell",
            "command": "${workspaceFolder}/.devcontainer/makehdl statemachine_tb.vcd",
            "options": {
                "cwd": "${workspaceFolder}/examples/statemachine",
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "revealProblems": "onProblem",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true,
            },
            "problemMatcher": {
                "base": "$vvp",
                "owner": "statemachine_tb: testbench",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/examples/statemachine",
                ],
            },
        },
        {
            "label": "02.05 statemachine iCE40 bitstream",
            "type": "shell",
            "command": "${workspaceFolder}/.devcontainer/makehdl products/statemachine.bin",
            "options": {
                "cwd": "${workspaceFolder}/examples/statemachine",
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "revealProblems": "onProblem",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true,
            },
            "problemMatcher": {
                "base": "$yosys",
                "owner": "statemachine: image",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/examples/statemachine",
                ],
            },
        },
        {
            "label": "03.01 Edit helloio.S",
            "type": "shell",
            "command": "code ${workspaceFolder}/examples/hello-risc-v/helloio.S",
        },
        {
            "label": "03.02 Run helloio.S",
            "type": "process",
            "command": "${command:workbench.action.debug.start}",
            "dependsOrder": "sequence",
            "dependsOn": "\"5.1 Edit helloio.S\"",
        },
        {
            "label": "03.03 Rebuild helloio.S SOC Firmware",
            "type": "shell",
            "command": "${workspaceFolder}/.devcontainer/makehdl products/helloio.S.fw.bin",
            "options": {
                "cwd": "${workspaceFolder}/examples/hello-risc-v",
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "revealProblems": "onProblem",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true,
            },
            "problemMatcher": {
                "base": "$yosys",
                "owner": "helloio.S: image",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/examples/hello-risc-v",
                ],
            },
        },
